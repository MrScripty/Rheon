@@ -564,7 +564,26 @@ impl PressureWorkspace {
             report.true_residual_l2 <= threshold
                 && report.predicted_divergence_max <= settings.divergence_limit
         };
-        let mut report = self.true_report(operator, dt, 0)?;
+        let mut report = if operator.has_gauge() {
+            // The sealed-box coefficients are finite and pressure was cleared
+            // to +0 above, so A*0 is +0 and rhs - A*0 preserves every RHS bit.
+            // Reuse its already-qualified ordered norm; retain full true
+            // residual evaluation for every subsequent iterate and surface.
+            self.product.copy_from_slice(&self.rhs);
+            let maximum = self.product.iter().fold(0.0_f64, |a, b| a.max(b.abs()));
+            let divergence = operator.scaled_residual_divergence(&self.product, dt);
+            if !divergence.is_finite() {
+                return Err(PressureError::Breakdown { iteration: 0 });
+            }
+            PressureReport {
+                iterations: 0,
+                true_residual_l2: rhs_l2,
+                true_residual_max: maximum,
+                predicted_divergence_max: divergence,
+            }
+        } else {
+            self.true_report(operator, dt, 0)?
+        };
         if accepted(report) {
             return Ok(report);
         }
