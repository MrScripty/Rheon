# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Research harness bytecode and disposable local runs
__pycache__/
rheon-comparisons/

# Runtime simulation exports and test/build caches; never repository inputs.
/.generated/
/simulation-output/
/rheon-output/
/evidence/**/*.csv
/evidence/**/*.jsonl
/evidence/**/*.log
/evidence/**/*.png
/evidence/**/*.gif
/evidence/**/*.html
/evidence/**/*.pdf
/evidence/**/*.zip
/evidence/**/*.gz
/evidence/**/demo/
# Legacy generators emit JSON observations here; existing source/audit manifests
# stay tracked. New authored configurations belong outside these output trees.
/evidence/**/*.json
/docs/research-book/**/evidence/**/*.json
/docs/research-book/**/evidence/**/*.log
/docs/research-book/**/evidence/**/*.txt
/docs/research-book/**/evidence/**/*.png
/docs/research-book/**/evidence/**/*.pdf
# PDFs are separately rendered downloads/artifacts, never committed binaries.
*.pdf

/evidence/**/*.txt
!/evidence/**/requirements.txt
!/evidence/**/source-manifest.json
!/evidence/**/qualified-source-manifest.json
!/evidence/**/source-inventory.json
!/evidence/**/config.json
